# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values you need.
# `.env.local` is ignored by Git — never commit real keys.
# ---------------------------------------------------------------------------

# Where enquiry forms are delivered.
# Leave both blank and the forms fall back to pre-filled WhatsApp + email,
# which works with no signup at all. See CONTENT-GUIDE.md.
#
# Example for Web3Forms (free tier, emails you each submission):
#   NEXT_PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
#   NEXT_PUBLIC_FORM_ACCESS_KEY=your-access-key
#
# Example for Formspree (no access key needed):
#   NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/your-form-id

NEXT_PUBLIC_FORM_ENDPOINT=
NEXT_PUBLIC_FORM_ACCESS_KEY=
